{
  "name": "moonmail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.19.0",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:browser": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "keeper": "tsx tools/keeper-cli.ts",
    "deploy:local": "tsx tools/deploy-local.ts",
    "format": "prettier --write src tools tests public docs .github *.json *.ts *.yaml index.html README.md"
  },
  "dependencies": {
    "@tari-project/ootle": "0.9.0",
    "@tari-project/ootle-indexer": "0.9.0",
    "@tari-project/ootle-secret-key-wallet": "0.9.0",
    "@tari-project/ootle-wasm": "0.46.0",
    "@tari-project/wallet_jrpc_client": "1.25.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "25.5.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "prettier": "3.8.1",
    "tsx": "4.22.0",
    "typescript": "5.9.3",
    "vite": "8.0.1",
    "vite-plugin-wasm": "3.6.0",
    "vitest": "4.1.0"
  }
}
