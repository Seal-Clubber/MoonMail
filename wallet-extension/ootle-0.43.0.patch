@@ -0,0 +1,388 @@
+// GhostDrop extension; MIT. Pinned to official wallet daemon v0.43.0.
+// Private mailbox keys are derived inside the wallet and never returned by RPC.
+use super::context::HandlerContext;
+use aes_gcm::{
+    Aes256Gcm, KeyInit, Nonce,
+    aead::{Aead, Payload},
+};
+use anyhow::{bail, ensure};
+use axum_extra::headers::authorization::Bearer;
+use base64::{Engine, engine::general_purpose::URL_SAFE_NO_PAD};
+use hkdf::Hkdf;
+use serde::{Deserialize, Serialize};
+use sha2::Sha256;
+use tari_crypto::{
+    keys::PublicKey,
+    ristretto::{RistrettoPublicKey, RistrettoSecretKey},
+    tari_utilities::{ByteArray, hex::Hex},
+};
+use tari_ootle_wallet_crypto::kdfs::encrypted_data_dh_kdf_aead;
+use tari_ootle_walletd_client::permissions::Permission;
+use tari_template_lib_types::ComponentAddress;
+use zeroize::Zeroizing;
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct MailboxContext {
+    pub network: u8,
+    pub registry: String,
+    pub template: String,
+    pub postbox: String,
+    pub controller: String,
+    pub key_version: u32,
+}
+impl MailboxContext {
+    fn validate(&self) -> anyhow::Result<()> {
+        ensure!([16, 36, 38].contains(&self.network), "Test networks only");
+        self.registry.parse::<ComponentAddress>()?;
+        ensure!(
+            self.template.len() == 64
+                && self
+                    .template
+                    .bytes()
+                    .all(|c| c.is_ascii_hexdigit() && !c.is_ascii_uppercase()),
+            "Invalid template"
+        );
+        ensure!(
+            !self.postbox.is_empty()
+                && self.postbox.len() <= 64
+                && self
+                    .postbox
+                    .bytes()
+                    .all(|c| c.is_ascii_alphanumeric() || c == b'_' || c == b'-'),
+            "Invalid postbox ID"
+        );
+        ensure!(
+            self.key_version > 0 && self.key_version <= 1_000_000,
+            "Invalid key version"
+        );
+        RistrettoPublicKey::from_hex(&self.controller).map_err(|_|anyhow::anyhow!("Invalid controller key"))?;
+        Ok(())
+    }
+    pub fn branch(&self) -> anyhow::Result<String> {
+        self.validate()?;
+        Ok(format!(
+            "ghostdrop/mailbox/{}",
+            serde_json::to_string(&serde_json::json!([
+                "gd-postbox-1",
+                self.network,
+                self.registry,
+                self.template,
+                self.postbox,
+                self.controller,
+                self.key_version
+            ]))?
+        ))
+    }
+}
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct PublicKeyRequest {
+    pub account: ComponentAddress,
+    pub context: MailboxContext,
+}
+#[derive(Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct PublicKeyResponse {
+    pub version: &'static str,
+    pub key_version: u32,
+    pub public_key: String,
+}
+#[derive(Deserialize, Serialize, Clone)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct SealedMailbox {
+    pub version: String,
+    pub key_version: u32,
+    pub recipient_key: String,
+    pub ephemeral_public_key: String,
+    pub iv: String,
+    pub ciphertext: String,
+}
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct DecryptRequest {
+    pub account: ComponentAddress,
+    pub context: MailboxContext,
+    pub envelope_id: String,
+    pub payload: SealedMailbox,
+}
+#[derive(Serialize)]
+pub struct Letter {
+    pub subject: String,
+    pub body: String,
+}
+
+fn derive(
+    context: &HandlerContext,
+    token: Option<&Bearer>,
+    req: &PublicKeyRequest,
+    permission: Permission,
+) -> anyhow::Result<RistrettoSecretKey> {
+    context.authorize(token, &[permission])?;
+    req.context.validate()?;
+    let sdk = context.wallet_sdk();
+    ensure!(req.context.network == sdk.network().as_byte(), "Wrong wallet network");
+    let account = sdk.accounts_api().get_account_by_address(&req.account)?;
+    ensure!(
+        account
+            .account
+            .owner_key_id
+            .is_some_and(|id| id.derived_index().is_some()),
+        "A seed-derived controlling account is required"
+    );
+    ensure!(
+        account.account.owner_public_key.to_string() == req.context.controller,
+        "Wrong postbox controller"
+    );
+    sdk.key_manager_api()
+        .derive_ghostdrop_mailbox_key(&req.context.branch()?)
+        .map_err(Into::into)
+}
+pub async fn handle_public_key(
+    context: &HandlerContext,
+    token: Option<&Bearer>,
+    req: PublicKeyRequest,
+) -> anyhow::Result<PublicKeyResponse> {
+    let secret = derive(context, token, &req, Permission::PostboxKeys(Some(req.account)))?;
+    Ok(PublicKeyResponse {
+        version: "gd-postbox-1",
+        key_version: req.context.key_version,
+        public_key: RistrettoPublicKey::from_secret_key(&secret).to_hex(),
+    })
+}
+pub async fn handle_decrypt(
+    context: &HandlerContext,
+    token: Option<&Bearer>,
+    req: DecryptRequest,
+) -> anyhow::Result<Letter> {
+    let public_req = PublicKeyRequest {
+        account: req.account,
+        context: req.context.clone(),
+    };
+    let secret = derive(
+        context,
+        token,
+        &public_req,
+        Permission::PostboxDecrypt(Some(req.account)),
+    )?;
+    decrypt_letter(&secret, &req.context, &req.envelope_id, &req.payload)
+}
+pub fn decrypt_letter(
+    secret: &RistrettoSecretKey,
+    context: &MailboxContext,
+    envelope_id: &str,
+    payload: &SealedMailbox,
+) -> anyhow::Result<Letter> {
+    context.validate()?;
+    ensure!(
+        serde_json::to_vec(payload)?.len() <= 4096 && !envelope_id.is_empty() && envelope_id.len() <= 64,
+        "Invalid envelope size/ID"
+    );
+    ensure!(
+        payload.version == "gd-postbox-1" && payload.key_version == context.key_version,
+        "Wrong envelope version"
+    );
+    ensure!(
+        RistrettoPublicKey::from_secret_key(secret).to_hex() == payload.recipient_key,
+        "Wrong historical mailbox key"
+    );
+    let peer = RistrettoPublicKey::from_hex(&payload.ephemeral_public_key).map_err(|_|anyhow::anyhow!("Invalid ephemeral key"))?;
+    ensure!(peer != RistrettoPublicKey::default(), "Identity key is not allowed");
+    let shared = encrypted_data_dh_kdf_aead(secret, &peer);
+    let aad = serde_json::to_vec(&serde_json::json!([
+        "GhostDrop",
+        "gd-postbox-1",
+        context.network,
+        context.registry,
+        context.template,
+        context.postbox,
+        context.controller,
+        context.key_version,
+        envelope_id,
+        payload.recipient_key,
+        payload.ephemeral_public_key
+    ]))?;
+    let salt = serde_json::to_vec(&serde_json::json!(["GhostDrop", "gd-postbox-1", "salt"]))?;
+    let mut key = Zeroizing::new([0u8; 32]);
+    Hkdf::<Sha256>::new(Some(&salt), shared.as_bytes())
+        .expand(&aad, key.as_mut())
+        .map_err(|_| anyhow::anyhow!("Key derivation failed"))?;
+    let iv = URL_SAFE_NO_PAD.decode(&payload.iv)?;
+    ensure!(
+        iv.len() == 12 && URL_SAFE_NO_PAD.encode(&iv) == payload.iv,
+        "Invalid nonce"
+    );
+    let ciphertext = URL_SAFE_NO_PAD.decode(&payload.ciphertext)?;
+    ensure!(
+        URL_SAFE_NO_PAD.encode(&ciphertext) == payload.ciphertext,
+        "Invalid ciphertext"
+    );
+    let cipher = Aes256Gcm::new_from_slice(key.as_ref()).map_err(|_| anyhow::anyhow!("Key rejected"))?;
+    let plain = Zeroizing::new(
+        cipher
+            .decrypt(
+                Nonce::from_slice(&iv),
+                Payload {
+                    msg: &ciphertext,
+                    aad: &aad,
+                },
+            )
+            .map_err(|_| anyhow::anyhow!("Cannot authenticate this letter"))?,
+    );
+    let value: serde_json::Value = serde_json::from_slice(plain.as_ref())?;
+    let (Some(subject), Some(body)) = (
+        value.get("subject").and_then(|v| v.as_str()),
+        value.get("body").and_then(|v| v.as_str()),
+    ) else {
+        bail!("Invalid letter")
+    };
+    Ok(Letter {
+        subject: subject.into(),
+        body: body.into(),
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use tari_common_types::seeds::mnemonic::{Mnemonic, MnemonicLanguage};
+    use tari_ootle_wallet_sdk::{CipherSeed, key_managers::WalletKeyStore, local_key_store::LocalKeyStore};
+
+    fn context() -> MailboxContext {
+        let seed = CipherSeed::random();
+        let controller = RistrettoPublicKey::from_secret_key(&seed.derive_secret("account", 0).unwrap()).to_hex();
+        MailboxContext {
+            network: 16,
+            registry: format!("component_{}", "a".repeat(64)),
+            template: "b".repeat(64),
+            postbox: "box-one".into(),
+            controller,
+            key_version: 1,
+        }
+    }
+    fn seal(secret: &RistrettoSecretKey, c: &MailboxContext, id: &str) -> SealedMailbox {
+        let ephemeral = CipherSeed::random().derive_secret("test-ephemeral", 0).unwrap();
+        let recipient = RistrettoPublicKey::from_secret_key(secret);
+        let recipient_key = recipient.to_hex();
+        let ephemeral_public_key = RistrettoPublicKey::from_secret_key(&ephemeral).to_hex();
+        let aad = serde_json::to_vec(&serde_json::json!([
+            "GhostDrop",
+            "gd-postbox-1",
+            c.network,
+            c.registry,
+            c.template,
+            c.postbox,
+            c.controller,
+            c.key_version,
+            id,
+            recipient_key,
+            ephemeral_public_key
+        ]))
+        .unwrap();
+        let salt = serde_json::to_vec(&serde_json::json!(["GhostDrop", "gd-postbox-1", "salt"])).unwrap();
+        let shared = encrypted_data_dh_kdf_aead(&ephemeral, &recipient);
+        let mut key = Zeroizing::new([0u8; 32]);
+        Hkdf::<Sha256>::new(Some(&salt), shared.as_bytes())
+            .expand(&aad, key.as_mut())
+            .unwrap();
+        let nonce = [7u8; 12];
+        let cipher = Aes256Gcm::new_from_slice(key.as_ref()).unwrap();
+        let ciphertext = cipher
+            .encrypt(
+                Nonce::from_slice(&nonce),
+                Payload {
+                    msg: br#"{"subject":"historical subject","body":"private message"}"#,
+                    aad: &aad,
+                },
+            )
+            .unwrap();
+        SealedMailbox {
+            version: "gd-postbox-1".into(),
+            key_version: c.key_version,
+            recipient_key,
+            ephemeral_public_key,
+            iv: URL_SAFE_NO_PAD.encode(nonce),
+            ciphertext: URL_SAFE_NO_PAD.encode(ciphertext),
+        }
+    }
+    #[test]
+    fn mailbox_mnemonic_recovery_and_historical_versions() {
+        let original = CipherSeed::random();
+        let c = context();
+        let secret = original.derive_secret(&c.branch().unwrap(), 0).unwrap();
+        let payload = seal(&secret, &c, "letter-1");
+        let words = original.to_mnemonic(MnemonicLanguage::English, None).unwrap();
+        let restored = LocalKeyStore::new(CipherSeed::from_mnemonic(&words, None).unwrap().into());
+        drop(original);
+        drop(words);
+        drop(secret);
+        let recovered = restored.derive_secret(&c.branch().unwrap(), 0).unwrap();
+        assert_eq!(
+            decrypt_letter(&recovered, &c, "letter-1", &payload).unwrap().subject,
+            "historical subject"
+        );
+        for changed in [
+            MailboxContext {
+                key_version: 2,
+                ..c.clone()
+            },
+            MailboxContext {
+                postbox: "box-two".into(),
+                ..c.clone()
+            },
+            MailboxContext {
+                network: 36,
+                ..c.clone()
+            },
+            MailboxContext {
+                registry: format!("component_{}", "c".repeat(64)),
+                ..c.clone()
+            },
+            MailboxContext {
+                template: "c".repeat(64),
+                ..c.clone()
+            },
+        ] {
+            let other = restored.derive_secret(&changed.branch().unwrap(), 0).unwrap();
+            assert_ne!(
+                RistrettoPublicKey::from_secret_key(&other),
+                RistrettoPublicKey::from_secret_key(&recovered)
+            );
+            assert!(decrypt_letter(&other, &changed, "letter-1", &payload).is_err());
+        }
+        assert_eq!(
+            decrypt_letter(&recovered, &c, "letter-1", &payload).unwrap().body,
+            "private message"
+        );
+    }
+    #[test]
+    fn tampering_and_readdressing_reject_without_plaintext() {
+        let c = context();
+        let secret = CipherSeed::random().derive_secret("mail-test", 0).unwrap();
+        let payload = seal(&secret, &c, "letter-1");
+        assert!(decrypt_letter(&secret, &c, "other-letter", &payload).is_err());
+        let mut changed = payload.clone();
+        let mut bytes = URL_SAFE_NO_PAD.decode(&changed.ciphertext).unwrap();
+        bytes[0] ^= 1;
+        changed.ciphertext = URL_SAFE_NO_PAD.encode(bytes);
+        assert!(decrypt_letter(&secret, &c, "letter-1", &changed).is_err());
+        let mut changed = payload.clone();
+        changed.ephemeral_public_key = "00".repeat(32);
+        assert!(decrypt_letter(&secret, &c, "letter-1", &changed).is_err());
+        let mut changed = payload.clone();
+        changed.iv.push('=');
+        assert!(decrypt_letter(&secret, &c, "letter-1", &changed).is_err());
+        assert!(
+            decrypt_letter(
+                &secret,
+                &MailboxContext {
+                    controller: context().controller,
+                    ..c.clone()
+                },
+                "letter-1",
+                &payload
+            )
+            .is_err()
+        );
+    }
+}
diff --git a/applications/tari_walletd/src/ghostdrop_origin.rs b/applications/tari_walletd/src/ghostdrop_origin.rs
new file mode 100644
--- /dev/null
+++ b/applications/tari_walletd/src/ghostdrop_origin.rs
@@ -0,0 +1,110 @@
+// GhostDrop extension; MIT. Origin policy is explicit and does not bypass bearer auth.
+use anyhow::ensure;
+use axum::{
+    extract::{Request, State},
+    http::{HeaderValue, Method, StatusCode, header},
+    middleware::Next,
+    response::{IntoResponse, Response},
+};
+use std::{net::SocketAddr, sync::Arc};
+use tower_http::cors::CorsLayer;
+
+#[derive(Clone)]
+pub struct OriginPolicy {
+    origins: Arc<Vec<HeaderValue>>,
+    host_port: u16,
+}
+impl OriginPolicy {
+    pub fn from_environment(address: SocketAddr) -> anyhow::Result<Option<Self>> {
+        let Ok(raw) = std::env::var("GHOSTDROP_WALLET_ORIGINS") else {
+            return Ok(None);
+        };
+        ensure!(
+            address.ip().is_loopback(),
+            "GhostDrop web access requires a loopback listener"
+        );
+        Self::parse(&raw, address.port()).map(Some)
+    }
+    fn parse(raw: &str, host_port: u16) -> anyhow::Result<Self> {
+        let mut origins = vec![];
+        for value in raw.split(',') {
+            let value = value.trim();
+            let u = url::Url::parse(value)?;
+            let local = matches!(u.host_str(), Some("localhost" | "127.0.0.1" | "[::1]"));
+            ensure!(
+                (u.scheme() == "https" || u.scheme() == "http" && local)
+                    && u.username().is_empty()
+                    && u.password().is_none()
+                    && u.path() == "/"
+                    && u.query().is_none()
+                    && u.fragment().is_none()
+                    && u.origin().ascii_serialization() == value,
+                "Supply exact HTTPS origins or loopback development origins"
+            );
+            origins.push(value.parse()?);
+        }
+        ensure!(
+            !origins.is_empty() && origins.len() <= 8,
+            "Choose 1..8 trusted web origins"
+        );
+        Ok(Self {
+            origins: Arc::new(origins),
+            host_port,
+        })
+    }
+    pub fn cors(&self) -> CorsLayer {
+        CorsLayer::new()
+            .allow_origin(self.origins.as_ref().clone())
+            .allow_methods([Method::POST, Method::OPTIONS])
+            .allow_headers([header::AUTHORIZATION, header::CONTENT_TYPE])
+            .allow_private_network(true)
+    }
+    fn allows(&self, host: Option<&HeaderValue>, origin: Option<&HeaderValue>) -> bool {
+        let Some(host) = host.and_then(|v| v.to_str().ok()) else {
+            return false;
+        };
+        let good_host = [
+            format!("localhost:{}", self.host_port),
+            format!("127.0.0.1:{}", self.host_port),
+            format!("[::1]:{}", self.host_port),
+        ]
+        .contains(&host.to_string());
+        good_host && origin.is_none_or(|o| self.origins.contains(o))
+    }
+}
+pub async fn guard(State(policy): State<OriginPolicy>, req: Request, next: Next) -> Response {
+    if !policy.allows(req.headers().get(header::HOST), req.headers().get(header::ORIGIN)) {
+        return (StatusCode::FORBIDDEN, "Wallet origin/host rejected").into_response();
+    }
+    next.run(req).await
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn origins_and_rebinding() {
+        let p = OriginPolicy::parse("https://seal-clubber.github.io", 15100).unwrap();
+        let host = HeaderValue::from_static("127.0.0.1:15100");
+        assert!(p.allows(
+            Some(&host),
+            Some(&HeaderValue::from_static("https://seal-clubber.github.io"))
+        ));
+        assert!(!p.allows(Some(&host), Some(&HeaderValue::from_static("https://evil.example"))));
+        assert!(!p.allows(Some(&HeaderValue::from_static("evil.example:15100")), None));
